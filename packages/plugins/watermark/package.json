{
  "name": "@scarlett-player/watermark",
  "version": "1.7.1",
  "description": "Watermark Plugin for Scarlett Player - anti-piracy text/image overlay",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "peerDependencies": {
    "@scarlett-player/core": "^1.7.0"
  },
  "devDependencies": {
    "@scarlett-player/core": "workspace:*",
    "@vitest/coverage-v8": "^1.6.0",
    "jsdom": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "video",
    "player",
    "watermark",
    "anti-piracy",
    "overlay",
    "scarlett"
  ],
  "author": "The Stream Platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hackney-Enterprises-Inc/scarlett-player.git",
    "directory": "packages/plugins/watermark"
  },
  "bugs": {
    "url": "https://github.com/Hackney-Enterprises-Inc/scarlett-player/issues"
  },
  "homepage": "https://scarlettplayer.com"
}

{
  "name": "@scarlett-player/vue",
  "version": "1.12.0",
  "description": "Vue 3 component wrapper for Scarlett Player",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist tsconfig.tsbuildinfo && vue-tsc -p tsconfig.json && vite build && publint",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.typecheck.json",
    "clean": "rimraf dist",
    "lint:publish": "publint"
  },
  "keywords": [
    "video",
    "player",
    "vue",
    "vue3",
    "composition-api",
    "scarlett",
    "hls",
    "streaming"
  ],
  "author": "The Stream Platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hackney-Enterprises-Inc/scarlett-player.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/Hackney-Enterprises-Inc/scarlett-player/issues"
  },
  "homepage": "https://scarlettplayer.com",
  "peerDependencies": {
    "@scarlett-player/core": "^1.8.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@scarlett-player/core": "workspace:*",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "publint": "^0.3.24",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vitest": "^1.1.0",
    "vue": "^3.3.0",
    "vue-tsc": "^2.2.12",
    "jsdom": "^24.0.0"
  }
}
